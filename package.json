{
  "name": "claude-code-studio-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run build && rm -rf packages/server/web-dist && node packages/server/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
