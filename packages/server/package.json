{
  "name": "cc-studio",
  "version": "0.1.0",
  "description": "Claude Code Studio — a local GUI for managing Claude Code settings: config files, MCP servers, plugins, hooks, agents, skills, and CLAUDE.md.",
  "keywords": [
    "claude",
    "claude-code",
    "settings",
    "gui",
    "mcp",
    "config"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": { "cc-studio": "./dist/bin.js" },
  "files": [
    "dist",
    "web-dist"
  ],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@claude-code-studio/core": "^0.1.0",
    "esbuild": "^0.24.0"
  }
}
