{
  "name": "cc-studio",
  "version": "0.3.0",
  "description": "Claude Code Studio — a local GUI for managing Claude Code settings: config files, MCP servers, plugins, hooks, agents, skills, and CLAUDE.md.",
  "keywords": [
    "claude",
    "claude-code",
    "settings",
    "gui",
    "mcp",
    "config"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msiShariful/claude-code-studio.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/msiShariful/claude-code-studio#readme",
  "bugs": "https://github.com/msiShariful/claude-code-studio/issues",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cc-studio": "./dist/bin.js"
  },
  "files": [
    "dist",
    "web-dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs",
    "prepack": "node scripts/prepack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@claude-code-studio/core": "^0.1.0",
    "esbuild": "^0.28.1"
  }
}
